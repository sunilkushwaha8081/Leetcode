#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

class Solution {
public:
    vector<int> singleNumber(vector<int>& nums) {
        vector<int> ans;
        unordered_map<int, int> mp;

        for (int x : nums) {
            mp[x]++;
        }

        for (auto y : mp) {
            if (y.second == 1)
                ans.push_back(y.first);
        }

        return ans;
    }
};

int main() {
    Solution sol;

    // Example input
    vector<int> nums = {1, 2, 1, 3, 2, 5};

    vector<int> ans = sol.singleNumber(nums);

    cout << "Single numbers: ";
    for (int x : ans) {
        cout << x << " ";
    }
    cout << endl;

    return 0;
}